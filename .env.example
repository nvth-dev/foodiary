# Comma-separated emails allowed to create and delete reviews in production.
ADMIN_EMAILS=you@example.com

# Local development only. Never enable this in Cloudflare production settings.
DEV_ADMIN_BYPASS=true

# Secret used to hash visitor identifiers for suggestion rate limiting.
SUGGESTION_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Cloudflare Turnstile for the public suggestion form.
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
